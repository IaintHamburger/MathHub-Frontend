# 應用程式標題
VITE_APP_TITLE=MathHub
#環境
VITE_ENVIRONMENT=production
# API 基礎 URL
VITE_API_BASE_URL=https://mathhubbackend.zeabur.app
# RSA 公鑰（用於加密敏感資料）
# 這是後端提供的 RSA 公鑰，用於加密登入時的密碼
# 格式應該是 PEM 格式的公鑰，例如：
# -----BEGIN PUBLIC KEY-----
# MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# -----END PUBLIC KEY-----
VITE_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"

# RSA 加密功能開關, 可以設定為 false 以關閉功能
VITE_RSA_ENCRYPTION_ENABLED=true
# 透過 http cookie 傳送 refreshToken 帶給後端, 基本上就是啟用 refreshToken 機制, 沒開就是一陣子後會自動被登出
VITE_USE_CREDENTIALS=true
